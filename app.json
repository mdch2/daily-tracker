{
  "expo": {
    "name": "Daily Tracker",
    "slug": "daily-tracker",
    "scheme": "dailytracker",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 30,
            "compileSdkVersion": 37,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "supportedLocales": ["en", "es"]
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "supportsRTL": false,
      "eas": {
        "projectId": "fe03dd4c-6fc8-4d29-a4d5-aa8ad18f7ccb"
      }
    },
    "owner": "mdch2s-team",
    "android": {
      "package": "com.mdch2steam.dailytracker"
    }
  }
}
